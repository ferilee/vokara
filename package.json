{
  "name": "vokara",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "build": "bun run build:web",
    "build:web": "bun --cwd apps/web build",
    "test": "bun run test:api && bun run test:activity",
    "test:api": "bun --cwd apps/api test",
    "test:activity": "bun --cwd packages/activity-sdk test",
    "typecheck": "bun run typecheck:web && bun run typecheck:api && bun run typecheck:database && bun run typecheck:activity",
    "typecheck:web": "bun --cwd apps/web typecheck",
    "typecheck:api": "bun --cwd apps/api typecheck",
    "typecheck:database": "bun --cwd packages/database typecheck",
    "typecheck:activity": "bun --cwd packages/activity-sdk typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
