# GitHub Container Registry namespace untuk repository ferilee/vokara.
GHCR_NAMESPACE=ferilee

# Tag image yang dipakai Arcane. Gunakan latest untuk rilis normal atau sha-<commit> untuk rollback.
IMAGE_TAG=latest

# Data SQLite di luar container.
VOKARA_DATA_DIR=/srv/data/vokara/sqlite

# Origin publik web yang diizinkan API.
CORS_ORIGIN=https://vokara.smkpasirian-lmj.sch.id
